# Local SQLite Prototype Database
DATABASE_URL=sqlite:///./krishilink.db

# JWT Configuration
JWT_SECRET_KEY=your-secure-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# SMTP Email Service for OTP Verification
# For Gmail: Use smtp.gmail.com with an App Password (not your personal password)
# For local prototype testing without SMTP: Leave SMTP_USERNAME blank; OTP will be printed to backend console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@krishilink.ai
SMTP_FROM_NAME=KrishiLink AI
SMTP_USE_TLS=true
