APP_NAME=KrishiLink AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
FORCE_HTTPS=false
MAX_REQUEST_BYTES=12582912
REQUIRE_EMAIL_VERIFICATION=false
TRUSTED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0", "testserver"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5500", "http://127.0.0.1:5500"]

